# Required in practice: the glasses send it as "Authorization: Bearer <token>".
CONVERSATE_TOKEN=change-me
# tiny | base | small | medium | large-v3 | turbo  (bigger = better Korean, slower)
WHISPER_MODEL=small
# cpu | cuda | auto
WHISPER_DEVICE=auto
# int8 (CPU) | float16 (GPU) | default
WHISPER_COMPUTE_TYPE=default
# empty = auto-detect
WHISPER_LANGUAGE=ko

# AI panel (top 30% of the glasses screen). Off when the key is empty.
OPENAI_API_KEY=
# gpt-6.1-terra (fast, default) | gpt-6-luna (cheapest) | gpt-6.1-sol (smarter)
ASSIST_MODEL=gpt-6.1-terra
# 1 = let the model search the web, 0 = no search.
# Web search makes one request ~9k tokens: free-tier OpenAI keys (10k TPM) get 429 right away.
ASSIST_WEB_SEARCH=1
